/**
 * Anonymize.gs
 * ------------------------------------------------------------------
 * 個人情報の匿名化（推奨案 = GASカスタム関数）
 *
 * 【2案の比較】
 *  案1: REGEXREPLACE を数式だけで多段ネストして匿名化する
 *       - 長所: GAS不要
 *       - 短所: 数式が長大でネストが深くなり「開始括弧が足りない」等の
 *               エラーが出やすく、保守が困難。パターン追加のたびに全行修正。
 *  案2(推奨): GASカスタム関数 =ANONYMIZE(E2) で匿名化する
 *       - 長所: パターンを1か所で管理でき、可読性・保守性が高い。
 *               警告判定も同じ場所で行える。数式はセルに =ANONYMIZE(E2) だけ。
 *       - 短所: スクリプトのインストールが必要（本システムでは元々GAS前提）。
 *
 * → 本システムは案2を推奨・実装。案1相当の数式もREADMEに記載。
 *
 * 【方針】
 *  - 氏名・住所を「過剰に」消して商品名・店舗名・地名・意味まで失わないよう、
 *    ラベル（氏名：/住所： 等）の直後だけをマスクする保守的な設計にする。
 *  - 電話・メール・郵便番号・URL・長い数字列は形式で検出してマスクする。
 * ------------------------------------------------------------------
 */

/**
 * クレーム原文を匿名化して返す。セルには =ANONYMIZE(E2) と入れる。
 * @param {string|string[][]} input 原文（配列範囲にも対応）
 * @return {string|string[][]} 匿名化済みテキスト
 * @customfunction
 */
function ANONYMIZE(input) {
  // 配列（範囲）で渡された場合は各要素を再帰処理
  if (Array.isArray(input)) {
    return input.map(function (row) {
      return row.map(function (v) { return anonymizeOne_(v); });
    });
  }
  return anonymizeOne_(input);
}

/**
 * 1件分の匿名化本体。
 * @param {*} raw
 * @return {string}
 */
function anonymizeOne_(raw) {
  if (raw === null || raw === undefined) return '';
  var s = String(raw);
  if (s.trim() === '') return '';

  // 1) メールアドレス
  s = s.replace(/[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}/g, '[メール]');

  // 2) URL
  s = s.replace(/https?:\/\/[^\s　、。）)]+/g, '[URL]');

  // 3) 郵便番号（〒付き）※〒があるものは電話より先に確定させる
  s = s.replace(/〒\s?\d{3}[-－]\d{4}/g, '[郵便番号]');

  // 4) 電話番号（0で始まる 9〜11桁、ハイフン許容）
  s = s.replace(/0\d{1,4}[-－(（]?\d{1,4}[-－)）]?\d{3,4}/g, '[電話番号]');

  // 5) 郵便番号（〒なしの 123-4567 形式。電話処理後の取りこぼし）
  s = s.replace(/\d{3}[-－]\d{4}/g, '[郵便番号]');

  // 6) 会員番号 / 注文番号 / 受注番号 / レシート番号（ラベル + 数字/英数）
  s = s.replace(/(会員番号|会員No|注文番号|受注番号|オーダー番号|レシート番号|取引番号|伝票番号)\s*[:：]?\s*[A-Za-z0-9\-－]{3,}/g, '$1：[番号]');

  // 7) ラベル付き氏名（氏名：/お名前：/顧客名：/名前：の直後の連続文字）
  //    「様」「さん」まで含めてマスク。過剰削除を避けるため句読点・空白で停止。
  s = s.replace(/(氏名|お名前|お客様名|顧客名|名前)\s*[:：]\s*[^\s、。　]{1,20}(様|さん)?/g, '$1：[氏名]');

  // 8) ラベル付き住所（住所：/ご住所：/お届け先：の直後）
  //    ★過剰削除防止: 空白・句読点で必ず停止する（商品名やクレーム本文を巻き込まない）。
  //    住所に内部空白がある場合は空白まで。取りこぼしは ANONYMIZE_WARN で検知。
  s = s.replace(/(ご住所|住所|お届け先|届け先)\s*[:：]\s*[^、。\n\s　]{1,40}/g, '$1：[住所]');

  // 9) 残った長い数字列（7桁以上）を番号としてマスク（電話等の取りこぼし対策）
  s = s.replace(/\d{7,}/g, '[番号]');

  return s;
}

/**
 * 匿名化しきれなかった可能性を検出して警告文言を返す（任意利用）。
 * セルに =ANONYMIZE_WARN(E2) と入れると使える。問題なければ空文字。
 * @param {string} raw 原文
 * @return {string} 警告（該当なしは空文字）
 * @customfunction
 */
function ANONYMIZE_WARN(raw) {
  if (raw === null || raw === undefined) return '';
  // 一般語（お客様など）とマスク済みプレースホルダを除外してから判定
  var s = String(raw).replace(/お客様|皆様|様々|\[[^\]]+\]/g, '');
  var warns = [];

  // ラベルは無いが氏名らしき「◯◯様/さん」が残っていないか
  if (/[一-龥ぁ-んァ-ヶ]{2,}(様|さん)/.test(s)) warns.push('氏名らしき表現');
  // 匿名化後も 7桁以上の数字が残る（通常はマスク済みだが原文チェック用）
  if (/\d{7,}/.test(s)) warns.push('長い数字列');
  // メール/URL の取りこぼし
  if (/@|https?:\/\//.test(s)) warns.push('メール/URL');

  return warns.length ? '要確認:' + warns.join('・') : '';
}
